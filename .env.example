# Telegram bot token (@BotFather dan oling)
BOT_TOKEN=123456:ABC-DEF...

# Bosh admin(lar) Telegram ID (vergul bilan): sizning ID @userinfobot dan
ADMIN_IDS=123456789

# DB fayl yo'li
DB_PATH=data/bot.db

# Skaner sozlamalari
SCAN_TIMEOUT=8
# Faol port skani yoqilganmi (faqat tasdiqlangan nishonlarga baribir tegishli)
ENABLE_ACTIVE_SCAN=true
